# Farm Studio backend settings.
# Copy this file to backend/.env and fill in the values. Never commit .env to git.

# --- NASA Earthdata Login (SMAP soil moisture, MODIS NDVI, ECOSTRESS via AppEEARS)
# Free account: https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- OpenTopography API key (NASA SRTM 30 m elevation for each field square) -
# Free key: https://portal.opentopography.org/requestService?service=api
# Without it, elevation falls back to the Copernicus 90 m DEM.
OPENTOPOGRAPHY_API_KEY=

# --- Contact e-mail for OpenStreetMap Nominatim (turns coordinates into place names)
# Nominatim's usage policy asks for a real contact address. Without it, plots show coordinates.
NOMINATIM_EMAIL=

# --- Optional ----------------------------------------------------------------
# Open-Meteo is free without a key for non-commercial use. For commercial use buy a key at
# https://open-meteo.com/en/pricing and set it here (switches to the commercial host).
OPEN_METEO_API_KEY=

# Database. SQLite file by default; for PostgreSQL use e.g.
#   postgresql+psycopg://user:pass@host:5432/farmstudio   (and pip install "psycopg[binary]")
# DATABASE_URL=sqlite:///./farmstudio.db

# Only needed if the web app is served from a different origin than the API.
# CORS_ORIGINS=https://farmstudio.example.org

# How often the satellite worker checks AppEEARS (seconds) and how old satellite data may get (days).
# APPEEARS_POLL_SECONDS=120
# APPEEARS_REFRESH_DAYS=8
# TOKEN_DAYS=30
